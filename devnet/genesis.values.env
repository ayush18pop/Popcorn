# Template for ethpandaops/ethereum-genesis-generator's /config/values.env.
# devnet/up.sh renders it into data/genesis.values.env, replacing the __PLACEHOLDERS__.
#
# Copied from the organisers' mempool-workshop-sidecar/deploy/devnet/genesis.values.env; same fork schedule
# (Fulu/Osaka at genesis, Gloas/Amsterdam epoch 1, Heze/Hegota epoch 2 - Gloas can't be active at genesis).
# Local changes: CHAIN_ID, a short GENESIS_DELAY, our premine, and the staking registry preloaded.

export PRESET_BASE="mainnet"
export SLOT_DURATION_MS="6000"

# 1338 (0x53a): one more than the public devnet's 1337, so a tx signed for one chain can never be replayed on
# the other, and a wallet/tool pointed at the wrong RPC fails on chain id instead of silently working.
export CHAIN_ID="1338"

export FULU_FORK_EPOCH="0"
export GLOAS_FORK_EPOCH="1"
export HEZE_FORK_EPOCH="2"

export NUMBER_OF_VALIDATORS="32"

# up.sh starts every container right after genesis is written, so a short delay is enough.
export GENESIS_DELAY="__GENESIS_DELAY__"

# The organisers' throwaway genesis account (0x5544...16f9, published in their repo), the predeploy deployer
# (0xa071...CDc0, published), our local dev accounts (devnet/keys/, anvil's public test mnemonic) and,
# optionally, the addresses of the repo's keys/*.json. Rendered by up.sh.
export EL_PREMINE_ADDRS='__EL_PREMINE_ADDRS__'

export DEPLOY_EIP8282_CONTRACTS="true"

# 0x0000BFF4...8282: the organisers' EIP-8282 deposit-predeploy inhibitor workaround (unchanged).
# 0xd51c04d7...2d2f: NaiveStakingRegistry runtime code (devnet/predeploys/NaiveStakingRegistry.runtime.hex,
#   byte-identical to the public devnet's code there), at the public devnet's address. On the public devnet it
#   is deployed by deploy/predeploy at deployer nonce 124; preloading it means it exists from block 0.
export ADDITIONAL_PRELOADED_CONTRACTS='__PRELOADED__'

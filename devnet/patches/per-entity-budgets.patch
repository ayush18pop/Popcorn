+ * SIDECAR_UNSTAKED_BUDGET / SIDECAR_STAKED_BUDGET override them (the public
+ * devnet's sidecar runs without a limit).
+ */
+export const MAX_VERIFY_GAS_PER_ENTITY = BigInt(process.env.SIDECAR_UNSTAKED_BUDGET ?? 250_000);
+export const MAX_VERIFY_GAS_STAKED_ENTITY = BigInt(process.env.SIDECAR_STAKED_BUDGET ?? 2_500_000);
+
+/**
+ * BUDGET-010: sums `limits.execution` per entity address over that
+ * entity's own validation frames. A `pre_verify` frame counts toward the
+ * entity of the approving frame it precedes (its target), signature
+ * verification counts toward `tx.sender`, and so does any prefix frame
+ * outside `prefix.frames` (a leading `expiry_verify`). Keyed by address,
+ * so a self-relay sender that is also its own payer gets one budget.
+ */
+export function sumVerifyGasPerEntity(
+  tx: FrameTransaction,
+  prefix: ValidationPrefixMatch
+): Map<`0x${string}`, bigint> {
+  const sums = new Map<`0x${string}`, bigint>();
+  const add = (addr: `0x${string}`, gas: bigint): void => {
+    sums.set(addr, (sums.get(addr) ?? BigInt(0)) + gas);
+  };
+  const sender = resolvedTarget(null, tx.sender);
+  const counted = new Set<number>();
+  for (const { frame, frameIndex, role } of prefix.frames) {
+    counted.add(frameIndex);
+    add(role === "sender" ? sender : resolvedTarget(frame.target, tx.sender), frame.limits.execution);
+  }
+  const lastPrefixIndex = Math.max(...counted);
+  for (let i = 0; i <= lastPrefixIndex; i++) {
+    if (!counted.has(i)) add(sender, tx.frames[i].limits.execution);
+  }
+  add(sender, signatureVerificationCost(tx));
+  return sums;
+}

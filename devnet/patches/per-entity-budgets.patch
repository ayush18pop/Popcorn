+import { describe, it, expect, vi } from "vitest";
+import { FrameTxValidationService } from "../../../../src/services/UserOpValidation/validators/frameTx.js";
+import { StakingRegistryService } from "../../../../src/services/StakingRegistryService/index.js";
+import { ReputationService } from "../../../../src/services/ReputationService.js";
+import { LocalDbController } from "../../../mocks/database.js";
+import { NetworkConfig } from "../../../../src/interfaces.js";
+import RpcError from "@skandha/types/lib/api/errors/rpc-error.js";
+import * as RpcErrorCodes from "@skandha/types/lib/api/errors/rpc-error-codes.js";
+import {
+  FRAME_MODE,
+  APPROVE_SCOPE,
+  Frame,
+  FrameTransaction,
+} from "@skandha/types/lib/contracts/FrameTx.js";
+
+// ERC-8421 BUDGET-010: per-entity validation gas, 250k unstaked / 2.5M staked.
+
+const SENDER = "0x1111111111111111111111111111111111111111" as const;
+const PAYMASTER = "0x5555555555555555555555555555555555555555" as const;
+const ENTRY_POINT = "0x00000000000000000000000000000000000000aa" as const;
+const STANDARD_MEMPOOL_ID = "test-standard-mempool";
+
+const UNSTAKED_CAP = 250_000n;
+const STAKED_CAP = 2_500_000n;
+
+const onlyVerify = (gas: bigint): Frame => ({
+  mode: FRAME_MODE.VERIFY,
+  flags: APPROVE_SCOPE.EXECUTION,
+  target: null,
+  limits: { execution: gas, state: 0n },
+  value: 0n,
+  data: "0x",
+});
+
+const selfVerify = (gas: bigint): Frame => ({
+  mode: FRAME_MODE.VERIFY,
+  flags: APPROVE_SCOPE.EXECUTION_AND_PAYMENT,
+  target: null,
+  limits: { execution: gas, state: 0n },
+  value: 0n,
+  data: "0x",
+});
+
+const payFrame = (target: `0x${string}`, gas: bigint): Frame => ({
+  mode: FRAME_MODE.VERIFY,
+  flags: APPROVE_SCOPE.PAYMENT,
+  target,
+  limits: { execution: gas, state: 0n },
+  value: 0n,
+  data: "0x",
+});
+
+const baseTx = (frames: Frame[]): FrameTransaction => ({
+  chainId: 1n,
+  nonceKeys: [0n],
+  nonceSeq: 0n,
+  sender: SENDER,
+  frames,
+  signatures: [],
+  fees: { maxPriorityFeePerGas: 1n, maxFeePerGas: 2n, maxFeePerBlobGas: 0n },
+  blobVersionedHashes: [],
+  recentRootReferences: [],
+});
+
+// One clean root trace per prefix frame, targeting that frame's entity.
+function simResultFor(targets: `0x${string}`[]): any {
+  return {
+    canonicalMempoolValid: true,
+    prefixShape: "SelfVerify",
+    payer: SENDER,
+    maxCost: "0x0",
+    canonicalMempoolViolation: null,
+    gasUsed: "0x64",
+    frames: targets.map(() => ({ gasUsed: "0x1", succeeded: true })),
+    executionStatus: "success",
+    executionError: null,
+    erc7562Trace: targets.map((to, frameIndex) => ({
+      frameIndex,
+      root: {
+        from: ENTRY_POINT,
+        to,
+        type: "CALL",
+        value: "0x0",
+        accessedSlots: { reads: {}, writes: {}, transientReads: {}, transientWrites: {} },
+        extCodeAccessInfo: [],
+        usedOpcodes: {},
+        contractSize: {},
+        outOfGas: false,
+      },
+    })),
+    erc7562TraceError: null,
+  };
+}
+
+type Deposit = { stake: bigint; unstakeDelaySec: number; withdrawTime: bigint };
+const GOOD_DEPOSIT: Deposit = { stake: 10_000_000_000n, unstakeDelaySec: 100, withdrawTime: 0n };
+const NO_DEPOSIT: Deposit = { stake: 0n, unstakeDelaySec: 0, withdrawTime: 0n };
+
+function registry(deposits: Record<string, Deposit> = {}) {
+  const getDepositInfo = vi.fn(
+    async (addr: string) => deposits[addr.toLowerCase()] ?? NO_DEPOSIT
+  );
+  return { getDepositInfo } as unknown as StakingRegistryService & {
+    getDepositInfo: ReturnType<typeof vi.fn>;
+  };
+}
+
+// Mirrors the existing frameTx.test.ts fake: staked addresses get code 0.
+function fakeReputation(stakedAddr?: string) {
+  const checkStake = vi.fn(async (info: { addr: string }) =>
+    stakedAddr && info.addr.toLowerCase() === stakedAddr.toLowerCase()
+      ? { code: 0, msg: "" }
+      : { code: 1, msg: "unstaked" }
+  );
+  return { checkStake } as unknown as ReputationService & {
+    checkStake: ReturnType<typeof vi.fn>;
+  };
+}
+
+// minStake 1e9 wei, minUnstakeDelay 10 s: the same thresholds as the real
+// ReputationService test above in frameTx.test.ts, plus a delay floor.
+let dbCounter = 0;
+const realReputation = () =>
+  new ReputationService(
+    new LocalDbController(`test-frameTxBudget-${dbCounter++}`),
+    1337,
+    10,
+    10,
+    50,
+    1_000_000_000n,
+    10
+  );
+
+const networkConfig = () =>
+  ({
+    minStake: 1_000_000_000n,
+    precompiles: [],
+    whitelistedEntities: {},
+    relayOpsWithWhitelistedEntities: false,
+    standardMempoolId: STANDARD_MEMPOOL_ID,
+  }) as unknown as NetworkConfig;
+
+const service = (reg: StakingRegistryService, rep: ReputationService) =>
+  new FrameTxValidationService(
+    reg,
+    rep,
+    networkConfig(),
+    { debug: vi.fn(), error: vi.fn() } as any
+  );
+
+// Canonical paymaster shape: only_verify for the sender, pay frame for PAYMASTER.
+const paymasterTx = (senderGas: bigint, paymasterGas: bigint) => ({
+  tx: baseTx([onlyVerify(senderGas), payFrame(PAYMASTER, paymasterGas)]),
+  sim: simResultFor([SENDER, PAYMASTER]),
+});
+
+describe("FrameTxValidationService BUDGET-010 (stake-aware per-entity verify gas)", () => {
+  it("1. entity at exactly 250,000, unstaked: accepted, registry not queried", async () => {
+    const reg = registry();
+    const rep = fakeReputation();
+    const tx = baseTx([selfVerify(UNSTAKED_CAP)]);
+    await expect(
+      service(reg, rep).validate(tx, simResultFor([SENDER]))
+    ).resolves.toMatchObject({ mempoolMembership: { [STANDARD_MEMPOOL_ID]: true } });
+    // validate() itself reads the registry later for roleStakes; the budget
+    // check must not have asked for the budget-only lookup before that, so
+    // assert on the stake check instead, which only the budget path (and
+    // storage rules, not triggered by this clean trace) would call.
+    expect(rep.checkStake).not.toHaveBeenCalled();
+  });
+
+  it("2. entity at 250,001, unstaked: rejected with BUDGET-010 unstaked", async () => {
+    const reg = registry();
+    const rep = fakeReputation();
+    const tx = baseTx([selfVerify(UNSTAKED_CAP + 1n)]);
+    const p = service(reg, rep).validate(tx, simResultFor([SENDER]));
+    await expect(p).rejects.toThrow(RpcError);
+    await expect(p).rejects.toThrow(/exceeds unstaked budget 250000 \(BUDGET-010\)/);
+    expect(reg.getDepositInfo).toHaveBeenCalledTimes(1);
+    expect(rep.checkStake).toHaveBeenCalledTimes(1);
+  });
+
+  it("3. entity at 2,500,000, staked: accepted", async () => {
+    const reg = registry({ [SENDER]: GOOD_DEPOSIT });
+    const rep = fakeReputation(SENDER);
+    const tx = baseTx([selfVerify(STAKED_CAP)]);
+    await expect(
+      service(reg, rep).validate(tx, simResultFor([SENDER]))
+    ).resolves.toMatchObject({ mempoolMembership: { [STANDARD_MEMPOOL_ID]: true } });
+    expect(rep.checkStake).toHaveBeenCalled();
+  });
+
+  it("4. entity at 2,500,001, staked: rejected with BUDGET-010 staked", async () => {
+    const reg = registry({ [SENDER]: GOOD_DEPOSIT });
+    const rep = fakeReputation(SENDER);
+    const tx = baseTx([selfVerify(STAKED_CAP + 1n)]);
+    const p = service(reg, rep).validate(tx, simResultFor([SENDER]));
+    await expect(p).rejects.toThrow(/exceeds staked budget 2500000 \(BUDGET-010\)/);
+    await expect(p).rejects.toMatchObject({ code: RpcErrorCodes.INVALID_USEROP });
+  });
+
+  describe("5. 300,000 gas with a failing real stake check", () => {
+    const cases: [string, Deposit][] = [
+      ["withdrawal started", { ...GOOD_DEPOSIT, withdrawTime: 1_700_000_000n }],
+      ["stake too low", { ...GOOD_DEPOSIT, stake: 1n }],
+      ["unstake delay too short", { ...GOOD_DEPOSIT, unstakeDelaySec: 1 }],
+    ];
+    it.each(cases)("%s: rejected as unstaked", async (_name, deposit) => {
+      const reg = registry({ [SENDER]: deposit });
+      const tx = baseTx([selfVerify(300_000n)]);
+      const p = service(reg, realReputation()).validate(tx, simResultFor([SENDER]));
+      await expect(p).rejects.toThrow(/exceeds unstaked budget 250000 \(BUDGET-010\)/);
+    });
+
+    it("control: the same deposit without the defect is accepted at 300,000", async () => {
+      const reg = registry({ [SENDER]: GOOD_DEPOSIT });
+      const tx = baseTx([selfVerify(300_000n)]);
+      await expect(
+        service(reg, realReputation()).validate(tx, simResultFor([SENDER]))
+      ).resolves.toMatchObject({ mempoolMembership: { [STANDARD_MEMPOOL_ID]: true } });
+    });
+  });
+
+  it("6. sender 240k and paymaster 240k, both unstaked: accepted (separate budgets)", async () => {
+    const reg = registry();
+    const rep = fakeReputation();
+    const { tx, sim } = paymasterTx(240_000n, 240_000n);
+    await expect(service(reg, rep).validate(tx, sim)).resolves.toMatchObject({
+      mempoolMembership: { [STANDARD_MEMPOOL_ID]: true },
+    });
+    expect(rep.checkStake).not.toHaveBeenCalled();
+  });
+
+  it("7. sender that is also the paymaster, 2 x 140k: one 280k budget, rejected when unstaked", async () => {
+    const reg = registry();
+    const rep = fakeReputation();
+    const tx = baseTx([onlyVerify(140_000n), payFrame(SENDER, 140_000n)]);
+    const p = service(reg, rep).validate(tx, simResultFor([SENDER, SENDER]));
+    await expect(p).rejects.toThrow(
+      new RegExp(`entity ${SENDER} validation gas 280000 exceeds unstaked budget 250000`)
+    );
+  });
+
+  describe("8. registry failure", () => {
+    it("getDepositInfo throws: the tx is rejected, not accepted", async () => {
+      const reg = registry();
+      reg.getDepositInfo.mockRejectedValue(new Error("rpc down"));
+      const { tx, sim } = paymasterTx(100_000n, 300_000n);
+      await expect(service(reg, fakeReputation()).validate(tx, sim)).rejects.toThrow(
+        "rpc down"
+      );
+    });
+
+    it("checkStake throws: the tx is rejected, not accepted", async () => {
+      const rep = fakeReputation();

interface Vm {
    function readFile(string calldata) external view returns (string memory);
    function parseJsonBytes(string calldata, string calldata) external pure returns (bytes memory);
    function parseJsonBytes32(string calldata, string calldata) external pure returns (bytes32);
    function parseJsonAddress(string calldata, string calldata) external pure returns (address);
    function parseJsonUint(string calldata, string calldata) external pure returns (uint256);
    function chainId(uint256) external;
    function prank(address) external;
    function etch(address, bytes calldata) external;
    function skip(bool) external;
}

contract DigestProbe {
    function intent(address ruleContract, uint256 ruleId, uint256 epoch, bytes32 h) external view returns (bytes32) {
        return IntentDigest.intentDigest(ruleContract, ruleId, epoch, h);
    }

    function attest(address ruleContract, bytes32 st, uint256 ruleId, uint256 epoch, bytes32 h) external view returns (bytes32) {
        return IntentDigest.attestationDigest(ruleContract, st, ruleId, epoch, h);
    }

    function domain(address ruleContract) external view returns (bytes32) {
        return IntentDigest.domainSeparator(ruleContract);
    }
}

/// Shared set-up: vectors generated by the SDK's TypeScript signers.
abstract contract IntentBase {
    Vm internal constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    event log_named_uint(string key, uint256 val);

    string internal J;
    address internal K; // the rule contract the vectors are for
    uint256 internal ruleId;
    uint256 internal epoch;
    bytes internal popArgs;
    bytes internal ctx;
    bytes32 internal digest;

    function setUp() public virtual {
        J = vm.readFile("test/fixtures/intent-vectors.json");
        vm.chainId(vm.parseJsonUint(J, ".chainId"));
        K = vm.parseJsonAddress(J, ".ruleContract");
        ruleId = vm.parseJsonUint(J, ".ruleId");
        epoch = vm.parseJsonUint(J, ".ruleEpoch");
        popArgs = vm.parseJsonBytes(J, ".popArgs");
        ctx = vm.parseJsonBytes(J, ".context");
        digest = vm.parseJsonBytes32(J, ".digest");
    }

    /// P256VERIFY (EIP-7951) exists only from the EVM version osaka. The project compiles for prague, so tests that need the
    /// precompile are SKIPPED there and run by `forge test --evm-version osaka` (scripts/test.sh does both).
    function _needP256() internal {
        if (!_hasP256()) vm.skip(true);
    }

    function _hasP256() internal view returns (bool ok) {
        // a known-good P256 vector (verified by ethrex's precompile)
        bytes memory input = hex"";
        (bool s, bytes memory r) = address(0x100).staticcall(input);
        ok = s && r.length == 32;
    }

    function _bytes(string memory key) internal view returns (bytes memory) {
        return vm.parseJsonBytes(J, key);
    }

    function _ctx(uint256 id, uint256 e, bytes memory args) internal pure returns (bytes memory) {
        return abi.encode(id, e, keccak256(args));
    }

    function _flip(bytes memory b, uint256 i) internal pure returns (bytes memory c) {
        c = abi.encodePacked(b);
        c[i] = bytes1(uint8(c[i]) ^ 0x01);
    }

    function _cut(bytes memory b, uint256 n) internal pure returns (bytes memory c) {
        c = new bytes(n);
        for (uint256 i; i < n; i++) c[i] = b[i];
    }

    function _ext(bytes memory b, bytes memory more) internal pure returns (bytes memory) {
        return abi.encodePacked(b, more);
    }

    /// check as `rule contract`: the predicate sees msg.sender == rule contract
    function _chk(IIntentScheme p, address ruleContract, bytes memory params, bytes memory context, bytes memory w) internal returns (bool) {
        vm.prank(ruleContract);
        return p.check(params, context, w);
    }

    function _ok(IIntentScheme p, bytes memory params, bytes memory w) internal returns (bool) {
        return _chk(p, K, params, ctx, w);
    }

    function _gas(IIntentScheme p, string memory name, bytes memory params, bytes memory w) internal {
        vm.prank(K);
        uint256 g = gasleft();
        bool r = p.check(params, ctx, w);
        g -= gasleft();
        require(r, "gas probe: check failed");
        emit log_named_uint(name, g);
    }

    /// the standard negative set every scheme must pass: wrong context pieces, wrong chain, wrong rule contract, bad context length
    function _contextNegatives(IIntentScheme p, bytes memory params, bytes memory w) internal {
        require(_ok(p, params, w), "baseline");
        require(!_chk(p, K, params, _ctx(ruleId + 1, epoch, popArgs), w), "other rule");
        require(!_chk(p, K, params, _ctx(ruleId, epoch + 1, popArgs), w), "other epoch");
        require(!_chk(p, K, params, _ctx(ruleId, epoch, _flip(popArgs, 0)), w), "other popArgs");
        require(!_chk(p, K, params, _cut(ctx, 95), w), "short context");
        require(!_chk(p, K, params, _ext(ctx, hex"00"), w), "long context");
        require(!_chk(p, K, params, "", w), "empty context");
        require(!_chk(p, address(uint160(K) + 1), params, ctx, w), "other rule contract");
        vm.chainId(1);
        require(!_ok(p, params, w), "other chain");
        vm.chainId(vm.parseJsonUint(J, ".chainId"));
        require(_ok(p, params, w), "baseline again");
    }
}

contract IntentDigestTest is IntentBase {
    function test_digestMatchesTypeScript() public {
        DigestProbe d = new DigestProbe();
        require(d.domain(K) == vm.parseJsonBytes32(J, ".domainSeparator"), "domain separator");
        require(d.intent(K, ruleId, epoch, keccak256(popArgs)) == digest, "intent digest");
        require(keccak256(ctx) == keccak256(_ctx(ruleId, epoch, popArgs)), "context");
        bytes32 st = vm.parseJsonBytes32(J, ".attested.statement");
        require(d.attest(K, st, ruleId, epoch, keccak256(popArgs)) == vm.parseJsonBytes32(J, ".attested.digest"), "attestation digest");
    }

    function test_digestBindsEveryField() public {
        DigestProbe d = new DigestProbe();
        bytes32 h = keccak256(popArgs);
        require(d.intent(K, ruleId + 1, epoch, h) != digest, "rule");
        require(d.intent(K, ruleId, epoch + 1, h) != digest, "epoch");
        require(d.intent(K, ruleId, epoch, bytes32(uint256(h) ^ 1)) != digest, "args");
        require(d.intent(address(uint160(K) + 1), ruleId, epoch, h) != digest, "rule contract");
        vm.chainId(2);
        require(d.intent(K, ruleId, epoch, h) != digest, "chain");
    }
}

contract EcdsaIntentTest is IntentBase {
    EcdsaSigner p;
    bytes params;
    bytes w;

    function setUp() public override {
        super.setUp();
        p = new EcdsaSigner();
        params = _bytes(".ecdsa.params");
        w = _bytes(".ecdsa.witness");
    }

    function test_valid() public {
        require(_ok(p, params, w), "valid");
        _gas(p, "ecdsa check gas", params, w);
    }

    function test_contextBinding() public {
        _contextNegatives(p, params, w);
    }

    function test_tamperedSignature() public {
        for (uint256 i; i < 65; i += 8) require(!_ok(p, params, _flip(w, i)), "tampered byte");
        require(!_ok(p, params, _flip(w, 64)), "v flipped to 26/28? (still must fail)");
    }

    function test_wrongKey() public {
        require(!_ok(p, abi.encodePacked(vm.parseJsonAddress(J, ".ecdsa.otherSigner")), w), "other signer");
        require(!_ok(p, abi.encodePacked(address(0)), w), "zero signer");
        require(!_ok(p, abi.encodePacked(address(0)), new bytes(65)), "zero signer, zero sig");
        require(_ok(p, abi.encodePacked(vm.parseJsonAddress(J, ".ecdsa.otherSigner")), _bytes(".ecdsa.otherWitness")), "other signer, own sig");
    }

    function test_malleabilityAndEncoding() public {
        bytes memory hi = abi.encodePacked(w);
        uint256 n = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141;
        uint256 s;
        for (uint256 i; i < 32; i++) s = (s << 8) | uint8(w[32 + i]);
        uint256 s2 = n - s; // the high-s twin is a valid ecrecover input for the flipped v
        for (uint256 i; i < 32; i++) hi[32 + i] = bytes1(uint8(s2 >> (8 * (31 - i))));
        hi[64] = bytes1(uint8(w[64]) == 27 ? 28 : 27);
        require(!_ok(p, params, hi), "high-s twin refused");
        bytes memory v0 = abi.encodePacked(w);
        v0[64] = bytes1(uint8(w[64]) - 27); // 0/1 form
        require(!_ok(p, params, v0), "v in {0,1} refused");
    }

    function test_malformedWitnessAndParams() public {
        require(!_ok(p, params, ""), "empty");
        require(!_ok(p, params, _cut(w, 64)), "64 bytes");
        require(!_ok(p, params, _ext(w, hex"00")), "66 bytes");
        require(!_ok(p, "", w), "empty params");
        require(!_ok(p, _cut(params, 19), w), "short params");
        require(!_ok(p, _ext(params, hex"00"), w), "long params");
        require(!_ok(p, params, new bytes(65)), "zero signature");
    }

    function testFuzz_randomWitnessNeverVerifies(bytes calldata junk) public {
        require(!_ok(p, params, junk), "junk");
    }
}

contract P256IntentTest is IntentBase {
    P256Signer p;
    bytes params;
    bytes w;

    function setUp() public override {
        super.setUp();
        _needP256();
        p = new P256Signer();
        params = _bytes(".p256.params");
        w = _bytes(".p256.witness");
    }

    function test_valid() public {
        require(_ok(p, params, w), "valid");
        _gas(p, "p256 check gas", params, w);
    }

    function test_contextBinding() public {
        _contextNegatives(p, params, w);
    }

    function test_tampered() public {
        for (uint256 i; i < 64; i += 7) require(!_ok(p, params, _flip(w, i)), "tampered byte");
    }

    function test_wrongKeyAndMalformed() public {
        require(!_ok(p, _bytes(".p256.otherParams"), w), "other key");
        require(!_ok(p, _cut(params, 63), w), "short params");
        require(!_ok(p, params, _cut(w, 63)), "short witness");
        require(!_ok(p, params, _ext(w, hex"00")), "long witness");
        require(!_ok(p, params, new bytes(64)), "zero sig");
        require(!_ok(p, new bytes(64), w), "zero key");
    }

    function test_highSTwinRefused() public {
        uint256 n = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551;
        uint256 s;
        for (uint256 i; i < 32; i++) s = (s << 8) | uint8(w[32 + i]);
        bytes memory hi = abi.encodePacked(w);
        uint256 s2 = n - s;
        for (uint256 i; i < 32; i++) hi[32 + i] = bytes1(uint8(s2 >> (8 * (31 - i))));
        require(!_ok(p, params, hi), "high-s twin refused (the precompile alone would accept it)");
    }
}

contract WebAuthnIntentTest is IntentBase {
    WebAuthnSigner p;

    function setUp() public override {
        super.setUp();
        _needP256();
        p = new WebAuthnSigner();
    }

    function test_valid() public {
        bytes memory w = _bytes(".webauthn.witness");
        require(_ok(p, _bytes(".webauthn.params"), w), "valid");
        require(_ok(p, _bytes(".webauthn.paramsNoRp"), w), "rp not checked");
        require(_ok(p, _bytes(".webauthn.paramsUV"), w), "UV required and present");
        _gas(p, "webauthn check gas", _bytes(".webauthn.params"), w);
    }

    function test_contextBinding() public {
        _contextNegatives(p, _bytes(".webauthn.params"), _bytes(".webauthn.witness"));
    }

    function test_flags() public {
        bytes memory params = _bytes(".webauthn.params");
        require(_ok(p, params, _bytes(".webauthn.witnessNoUv")), "UV not required");
        require(!_ok(p, _bytes(".webauthn.paramsUV"), _bytes(".webauthn.witnessNoUv")), "UV required, absent");
        require(!_ok(p, params, _bytes(".webauthn.witnessNoUp")), "user presence required");
    }

    function test_validParamsRequiresRpIdHash() public {
        require(p.validParams(_bytes(".webauthn.params")), "rpId pinned");
        require(p.validParams(_bytes(".webauthn.paramsUV")), "rpId pinned, UV");
        require(!p.validParams(_bytes(".webauthn.paramsNoRp")), "zero rpIdHash refused by the deploy-time check");
        require(!p.validParams(_cut(_bytes(".webauthn.params"), 127)), "short");
    }

    function test_rpIdMismatch() public {
        require(!_ok(p, _bytes(".webauthn.paramsOtherRp"), _bytes(".webauthn.witness")), "rpIdHash mismatch");
    }

    function test_malformedClientData() public {
        bytes memory params = _bytes(".webauthn.params");
        require(!_ok(p, params, _bytes(".webauthn.witnessBadJson")), "JSON cut before the challenge's closing quote");
        require(!_ok(p, params, _bytes(".webauthn.witnessNoChallenge")), "no challenge field");
        require(!_ok(p, params, _bytes(".webauthn.witnessWrongChallenge")), "challenge differs in one character");
        // by design the document is not parsed: both fields at the stated offsets is enough (only the user's own authenticator signs it)
        require(_ok(p, params, _bytes(".webauthn.witnessUnterminated")), "no closing brace is accepted");
        require(!_ok(p, params, _bytes(".webauthn.witnessCreate")), "type webauthn.create");
    }

    function test_offsetsAndTruncation() public {
        bytes memory params = _bytes(".webauthn.params");
        bytes memory w = _bytes(".webauthn.witness");
        for (uint256 i = 64; i < 70; i++) require(!_ok(p, params, _flip(w, i)), "offset/length byte changed");
        require(!_ok(p, params, _cut(w, w.length - 1)), "JSON truncated by one byte");
        require(!_ok(p, params, _cut(w, 100)), "truncated inside authData");
        require(!_ok(p, params, _cut(w, 60)), "shorter than the header");
        require(!_ok(p, params, ""), "empty");
        for (uint256 i = 70; i < 100; i += 9) require(!_ok(p, params, _flip(w, i)), "authenticatorData byte");
        for (uint256 i = 0; i < 64; i += 9) require(!_ok(p, params, _flip(w, i)), "signature byte");
        require(!_ok(p, _bytes(".p256.params"), w), "wrong key (params also too short)");
    }

    function testFuzz_junk(bytes calldata junk) public {
        require(!_ok(p, _bytes(".webauthn.params"), junk), "junk");
    }
}

contract WotsIntentTest is IntentBase {
    WotsSigner p;
    bytes params;
    bytes w;

    function setUp() public override {
        super.setUp();
        p = new WotsSigner();
        params = _bytes(".wots.params");
        w = _bytes(".wots.witness");
    }

    function test_valid() public {
        require(w.length == 2496, "witness length");
        require(_ok(p, params, w), "valid");
        _gas(p, "wots check gas", params, w);
    }

    function test_contextBinding() public {
        _contextNegatives(p, params, w);
    }

    function test_tamperedEveryRegion() public {
        require(!_ok(p, params, _flip(w, 0)), "salt");
        for (uint256 i = 32; i < w.length; i += 211) require(!_ok(p, params, _flip(w, i)), "chain or path byte");
        require(!_ok(p, params, _flip(w, w.length - 1)), "last path byte");
        require(!_ok(p, params, _flip(w, 32 + 32 * 66)), "last chain");
    }

    /// the vector's WOTS params with another firstEpoch (chain id and rule id kept)
    function _wp(uint256 first) internal view returns (bytes memory) {
        return abi.encodePacked(_cut(params, 64), first, vm.parseJsonUint(J, ".chainId"), ruleId);
    }

    function test_keyIsBoundToOneChainAndOneRule() public {
        require(_ok(p, params, w), "baseline");
        // same key, params naming another rule: the signed context (rule 4) is refused although the signature is valid for it
        require(!_ok(p, abi.encodePacked(_cut(params, 128), ruleId + 1), w), "key bound to another rule");
        require(!_ok(p, abi.encodePacked(_cut(params, 96), vm.parseJsonUint(J, ".chainId") + 1, ruleId), w), "key bound to another chain");
        // a context for the other rule is refused by the digest AND by the binding (two independent reasons)
        require(!_chk(p, K, params, _ctx(ruleId + 1, epoch, popArgs), w), "context for another rule");
    }

    function test_leafIsBoundToTheEpoch() public {
        // signed for epoch 7 with firstEpoch 5 (leaf 2): the same signature at epoch 8 (leaf 3) or 6 (leaf 1) is not the signed message
        require(!_chk(p, K, params, _ctx(ruleId, epoch + 1, popArgs), w), "epoch + 1");
        require(!_chk(p, K, params, _ctx(ruleId, epoch - 1, popArgs), w), "epoch - 1");
        // a params blob with another firstEpoch maps epoch 7 to another leaf
        bytes memory other = _wp(4);
        require(!_ok(p, other, w), "other firstEpoch -> other leaf");
        // an epoch below firstEpoch has no leaf
        bytes memory late = _wp(8);
        require(!_ok(p, late, w), "epoch below firstEpoch");
        // beyond the tree (leaf 1024)
        bytes memory far = _wp(0);
        require(!_chk(p, K, far, _ctx(ruleId, 1024, popArgs), w), "leaf 1024");
    }

    function test_wrongKeyAndMalformed() public {
        require(!_ok(p, abi.encodePacked(bytes32(uint256(1)), _cut(params, 96)), w), "different root"); // longer params
        require(!_ok(p, _flip(params, 0), w), "root flipped");
        require(!_ok(p, _flip(params, 33), w), "pubSeed flipped");
        require(!_ok(p, _cut(params, 159), w), "short params");
        require(!_ok(p, params, _cut(w, 2495)), "short witness");
        require(!_ok(p, params, _ext(w, hex"00")), "long witness");
        require(!_ok(p, params, new bytes(2496)), "zero witness");
        require(!_ok(p, params, ""), "empty");
    }
}

contract HybridIntentTest is IntentBase {
    HybridEcdsaWotsSigner h;
    HybridEcdsaSigner g;
    WotsSigner inner;
    bytes params;
    bytes w;

    function setUp() public override {
        super.setUp();
        h = new HybridEcdsaWotsSigner();
        g = new HybridEcdsaSigner();
        inner = new WotsSigner();
        params = _bytes(".hybrid.params");
        w = abi.encodePacked(_bytes(".hybrid.ecdsaWitness"), _bytes(".hybrid.wotsWitness"));
    }

    function test_valid() public {
        require(_ok(h, params, w), "valid");
        _gas(h, "hybrid ecdsa+wots check gas", params, w);
    }

    function test_contextBinding() public {
        _contextNegatives(h, params, w);
    }

    function test_bothHalvesRequired() public {
        bytes memory e = _bytes(".hybrid.ecdsaWitness");
        bytes memory q = _bytes(".hybrid.wotsWitness");
        require(!_ok(h, params, abi.encodePacked(new bytes(65), q)), "ecdsa half zeroed");
        require(!_ok(h, params, abi.encodePacked(e, new bytes(2496))), "wots half zeroed");
        require(!_ok(h, params, abi.encodePacked(_flip(e, 3), q)), "ecdsa tampered");
        require(!_ok(h, params, abi.encodePacked(e, _flip(q, 100))), "wots tampered");
        // another ECDSA signer's valid signature does not do
        require(!_ok(h, params, abi.encodePacked(_bytes(".ecdsa.otherWitness"), q)), "other ecdsa signer");
        require(!_ok(h, params, e), "ecdsa half only");
        require(!_ok(h, params, q), "wots half only");
        require(!_ok(h, _cut(params, 179), w), "short params");
        require(!_ok(h, params, _ext(w, hex"00")), "long witness");
    }

    function test_genericWrapperWithWots() public {
        bytes memory gp = abi.encodePacked(_cut(params, 20), address(inner), _bytes(".wots.params"));
        require(_ok(g, gp, w), "generic hybrid == ecdsa + wots predicate");
        _gas(g, "generic hybrid (ecdsa + wots predicate) check gas", gp, w);
        _contextNegatives(g, gp, w);
        require(!_ok(g, gp, abi.encodePacked(new bytes(65), _bytes(".hybrid.wotsWitness"))), "ecdsa half zeroed");
        require(!_ok(g, gp, abi.encodePacked(_bytes(".hybrid.ecdsaWitness"), _flip(_bytes(".hybrid.wotsWitness"), 40))), "inner tampered");
        require(!_ok(g, abi.encodePacked(_cut(params, 20), address(0xdead), _bytes(".wots.params")), w), "inner is not a contract -> false");
        require(!_ok(g, _cut(gp, 39), w), "short params");
    }
}

contract MultisigIntentTest is IntentBase {
    MultisigSigner p;
    bytes params;

    function setUp() public override {
        super.setUp();
        p = new MultisigSigner();
        params = _bytes(".multisig.params");
    }

    function test_validEcdsaWots() public {
        require(p.validParams(params), "params valid");
        require(_ok(p, params, _bytes(".multisig.witness02")), "ecdsa + wots");
        _gas(p, "multisig 2-of-3 (ecdsa + wots) check gas", params, _bytes(".multisig.witness02"));
    }

    function test_validWithP256() public {
        _needP256();
        require(_ok(p, params, _bytes(".multisig.witness01")), "ecdsa + p256");
        require(_ok(p, params, _bytes(".multisig.witness12")), "p256 + wots");
        _gas(p, "multisig 2-of-3 (ecdsa + p256) check gas", params, _bytes(".multisig.witness01"));
        _gas(p, "multisig 2-of-3 (p256 + wots) check gas", params, _bytes(".multisig.witness12"));
    }

    function test_threeOfThree() public {
        _needP256();
        require(_ok(p, _bytes(".multisig.params3of3"), _bytes(".multisig.witness3")), "3 of 3");
        require(!_ok(p, _bytes(".multisig.params3of3"), _bytes(".multisig.witness01")), "2 sigs for 3 of 3");
    }

    function test_contextBinding() public {
        _contextNegatives(p, params, _bytes(".multisig.witness02"));
    }

    function test_contextBindingWithP256() public {
        _needP256();
        _contextNegatives(p, params, _bytes(".multisig.witness01"));
    }

    function test_belowThresholdAndPadding() public {
        // one signature only: count byte 1 != threshold 2
        bytes memory one = abi.encodePacked(uint8(1), uint8(0), uint16(65), _sig(0));
        require(!_ok(p, params, one), "1 of 2");
        // count 3 with 3 signatures for threshold 2
        bytes memory three = abi.encodePacked(uint8(3), uint8(0), uint16(65), _sig(0), uint8(1), uint16(64), _sig(1), uint8(2), uint16(2496), _sig(2));
        require(!_ok(p, params, three), "3 signatures for threshold 2");
    }

    function _sig(uint256 i) internal view returns (bytes memory) {
        return vm.parseJsonBytes(J, string.concat(".multisig.sigs[", i == 0 ? "0" : i == 1 ? "1" : "2", "]"));
    }

    function test_duplicateSignerAndOrder() public {
        // the same signer twice (indexes 0, 0), and decreasing order (1, 0)
        bytes memory dup = abi.encodePacked(uint8(2), uint8(0), uint16(65), _sig(0), uint8(0), uint16(65), _sig(0));
        require(!_ok(p, params, dup), "same slot twice");
        bytes memory rev = abi.encodePacked(uint8(2), uint8(1), uint16(64), _sig(1), uint8(0), uint16(65), _sig(0));
        require(!_ok(p, params, rev), "decreasing index");
        bytes memory oob = abi.encodePacked(uint8(2), uint8(0), uint16(65), _sig(0), uint8(3), uint16(65), _sig(0));
        require(!_ok(p, params, oob), "index out of range");
    }

    function test_signatureForAnotherSlot() public {
        // ecdsa signature presented as slot 1's (a P256 key), p256 as slot 0's
        bytes memory swapped = abi.encodePacked(uint8(2), uint8(0), uint16(64), _sig(1), uint8(1), uint16(65), _sig(0));
        require(!_ok(p, params, swapped), "signatures in the wrong slots");
    }

    function test_tamperedEntries() public {
        bytes memory w = _bytes(".multisig.witness02");
        require(_ok(p, params, w), "baseline");
        for (uint256 i = 1; i < w.length; i += 197) require(!_ok(p, params, _flip(w, i)), "byte flipped");
        require(!_ok(p, params, _cut(w, w.length - 1)), "truncated");
        require(!_ok(p, params, _ext(w, hex"00")), "trailing byte");
        require(!_ok(p, params, ""), "empty witness");
    }

    function test_paramsRules() public {
        require(!p.validParams(_cut(params, params.length - 1)), "truncated params");
        require(!p.validParams(abi.encodePacked(uint8(0), _cut(_cut2(params), 0))), "threshold 0");
        // duplicate keys
        bytes memory k0 = _bytes(".ecdsa.params");
        bytes memory dup = abi.encodePacked(uint8(2), uint8(2), uint8(0), k0, uint8(0), k0);
        require(!p.validParams(dup), "duplicate key");
        // threshold above n, unknown scheme, n above 16
        require(!p.validParams(abi.encodePacked(uint8(3), uint8(2), uint8(0), k0, uint8(0), _bytes(".ecdsa.otherSigner"))), "k > n");
        require(!_ok(p, abi.encodePacked(uint8(2), uint8(2), uint8(9), k0, uint8(0), k0), _bytes(".multisig.witness01")), "unknown scheme");
        bytes memory many = abi.encodePacked(uint8(1), uint8(17));
        for (uint256 i; i < 17; i++) many = abi.encodePacked(many, uint8(0), address(uint160(i + 1)));
        require(!p.validParams(many), "n = 17");
        require(!_ok(p, many, abi.encodePacked(uint8(1), uint8(0), uint16(65), _sig(0))), "n = 17 refused when checking too");
        // params with trailing garbage are refused when checking
        require(!_ok(p, _ext(params, hex"00"), _bytes(".multisig.witness01")), "trailing params");
    }

    function _cut2(bytes memory b) internal pure returns (bytes memory) {
        return _cut(b, b.length);
    }
}

contract AttestedFactIntentTest is IntentBase {
    AttestedFactSigner p;
    bytes params;
    bytes w;

    function setUp() public override {
        super.setUp();
        p = new AttestedFactSigner();
        params = _bytes(".attested.params");
        w = _bytes(".attested.witness");
    }

    function _sig(uint256 i) internal view returns (bytes memory) {
        return vm.parseJsonBytes(J, string.concat(".attested.sigs[", i == 0 ? "0" : i == 1 ? "1" : "2", "]"));
    }

    function test_valid() public {
        require(p.validParams(params), "params valid");
        require(_ok(p, params, w), "attestors 0 and 2");
        require(_ok(p, params, abi.encodePacked(uint8(0), _sig(0), uint8(1), _sig(1))), "attestors 0 and 1");
        require(_ok(p, params, abi.encodePacked(uint8(1), _sig(1), uint8(2), _sig(2))), "attestors 1 and 2");
        _gas(p, "attested 2-of-3 check gas", params, w);
    }

    function test_contextBinding() public {
        _contextNegatives(p, params, w);
    }

    function test_statementIsBound() public {
        // the same attestors, another statement in the params: their signatures do not cover it
        bytes memory other = abi.encodePacked(bytes32(uint256(vm.parseJsonUint(J, ".chainId"))), _tail(params));
        require(!_ok(p, other, w), "another statement");
    }

    function _tail(bytes memory b) internal pure returns (bytes memory t) {
        t = new bytes(b.length - 32);
        for (uint256 i; i < t.length; i++) t[i] = b[32 + i];
    }

    function test_intentSignaturesAreNotAttestations() public {
        // ordinary intent signatures (other typehash) by the same keys do not count: reuse the ECDSA vector signer as a sanity check
        require(!_ok(p, params, abi.encodePacked(uint8(0), _bytes(".ecdsa.witness"), uint8(1), _bytes(".ecdsa.otherWitness"))), "intent sigs");
    }

    function test_thresholdOrderDuplicatesPadding() public {
        require(!_ok(p, params, abi.encodePacked(uint8(0), _sig(0))), "1 of 2");
        require(!_ok(p, params, abi.encodePacked(uint8(0), _sig(0), uint8(1), _sig(1), uint8(2), _sig(2))), "3 attestations for k = 2");
        require(!_ok(p, params, abi.encodePacked(uint8(0), _sig(0), uint8(0), _sig(0))), "one attestor twice");
        require(!_ok(p, params, abi.encodePacked(uint8(2), _sig(2), uint8(0), _sig(0))), "decreasing");
        require(!_ok(p, params, abi.encodePacked(uint8(0), _sig(0), uint8(3), _sig(2))), "index out of range");
        require(!_ok(p, params, abi.encodePacked(uint8(0), _sig(1), uint8(2), _sig(2))), "signature of attestor 1 as attestor 0");
        require(!_ok(p, params, _flip(w, 5)), "tampered");
        require(!_ok(p, params, _ext(w, hex"00")), "trailing byte");
        require(!_ok(p, params, ""), "empty");
    }

    function test_paramsRules() public {
        require(!p.validParams(_cut(params, params.length - 1)), "truncated");
        address a = vm.parseJsonAddress(J, ".ecdsa.signer");
        require(!p.validParams(abi.encodePacked(bytes32(0), uint8(2), uint8(2), a, a)), "duplicate attestor");
        require(!p.validParams(abi.encodePacked(bytes32(0), uint8(0), uint8(1), a)), "k = 0");
        require(!p.validParams(abi.encodePacked(bytes32(0), uint8(1), uint8(1), address(0))), "zero attestor");
        require(!_ok(p, _cut(params, params.length - 1), w), "truncated params when checking");
    }
}

/// Where the EVM has no EIP-7951 precompile (prague), a P-256 check must fail closed (false), never pass.
contract P256AbsentTest is IntentBase {
    function test_noPrecompileFailsClosed() public {
        if (_hasP256()) vm.skip(true);
        P256Signer p = new P256Signer();
        WebAuthnSigner wp = new WebAuthnSigner();
        require(!_ok(p, _bytes(".p256.params"), _bytes(".p256.witness")), "p256 -> false");
        require(!_ok(wp, _bytes(".webauthn.params"), _bytes(".webauthn.witness")), "webauthn -> false");
    }
}

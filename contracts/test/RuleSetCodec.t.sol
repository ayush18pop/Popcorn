pragma solidity ^0.8.28;

import "src/rules/RuleSetCodec.sol";

interface VmJson {
    function readFile(string calldata) external view returns (string memory);
    function parseJsonBytes(string calldata, string calldata) external pure returns (bytes memory);
}

contract RuleSetValidatorExt {
    function validate(bytes calldata c) external pure {
        RuleSetCodec.validate(c);
    }
}

/// The SDK's encoder and these Solidity builders must produce the same bytes, and the
/// two validators must agree. Vectors: test/fixtures/ruleset-vectors.json (generated by the SDK).
contract RuleSetCodecTest {
    VmJson constant vm = VmJson(address(uint160(uint256(keccak256("hevm cheat code")))));
    RuleSetValidatorExt internal v = new RuleSetValidatorExt();

    address constant A1 = address(uint160(0xa0001));
    address constant A2 = address(uint160(0xa0002));
    address constant A3 = address(uint160(0xa0003));
    bytes4 constant SEL = bytes4(keccak256("value()"));
    bytes32 constant H32 = bytes32(hex"abababababababababababababababababababababababababababababababab");

    function _k1(bytes memory a) internal pure returns (bytes[] memory k) {
        k = new bytes[](1);
        k[0] = a;
    }

    function _k2(bytes memory a, bytes memory b) internal pure returns (bytes[] memory k) {
        k = new bytes[](2);
        k[0] = a;
        k[1] = b;
    }

    function _k3(bytes memory a, bytes memory b, bytes memory c) internal pure returns (bytes[] memory k) {
        k = new bytes[](3);
        k[0] = a;
        k[1] = b;
        k[2] = c;
    }

    function _k4(bytes memory a, bytes memory b, bytes memory c, bytes memory d) internal pure returns (bytes[] memory k) {
        k = new bytes[](4);
        k[0] = a;
        k[1] = b;
        k[2] = c;
        k[3] = d;
    }

    function _one(bytes memory tree, uint16 maxFires, uint8 at, bytes memory action, uint32 gas_) internal pure returns (bytes memory) {
        RuleSetCodec.Rule[] memory r = new RuleSetCodec.Rule[](1);
        r[0] = RuleSetCodec.rule(tree, maxFires, at, action, gas_);
        if (at == ACTION_CALL) r[0] = RuleSetCodec.withRetry(r[0]); // the SDK's default for CALL actions
        return RuleSetCodec.encode(0, r);
    }

    function _vector(uint256 i) internal pure returns (bytes memory c) {
        if (i == 0) return _one(RuleSetCodec.constant_(true), 1, ACTION_NONE, "", 0);
        if (i == 1) {
            bytes memory t = RuleSetCodec.and_(_k2(RuleSetCodec.cmp(RuleSetCodec.srcGetter(A1, SEL, 30_000), OP_GT, 5), RuleSetCodec.range(RuleSetCodec.srcStorage(H32), 1, 9, false)));
            return _one(t, 0, ACTION_CALL, RuleSetCodec.actionCall(A2, 7, hex"deadbeef"), 90_000);
        }
        if (i == 2) {
            bytes memory kof = RuleSetCodec.kofn(
                2, _k3(RuleSetCodec.cmp(RuleSetCodec.srcGetterSelf(A1, SEL, 20_000), OP_LE, 3), RuleSetCodec.cmp(RuleSetCodec.srcGetter(A2, SEL, 25_000), OP_EQ, 1), RuleSetCodec.constant_(false))
            );
            bytes memory t = RuleSetCodec.or_(_k2(RuleSetCodec.not_(kof), RuleSetCodec.and_(_k2(RuleSetCodec.constant_(true), RuleSetCodec.constant_(false)))));
            return _one(t, 3, ACTION_NONE, "", 0);
        }
        if (i == 3) {
            bytes memory t = RuleSetCodec.and_(
                _k4(
                    RuleSetCodec.crossing(RuleSetCodec.srcGetterArg(A1, SEL, H32, 30_000), 100, DIR_EITHER, 50, 3),
                    RuleSetCodec.delta(RuleSetCodec.srcErc20Self(A2, 40_000), 1500, DIR_DOWN, 1000, 3),
                    RuleSetCodec.ratio(RuleSetCodec.srcEthBalance(A3), RuleSetCodec.srcErc20(A1, A3, 35_000), OP_GE, 3, 2),
                    RuleSetCodec.cmp(RuleSetCodec.srcEthBalanceSelf(), OP_NE, 0)
                )
            );
            return _one(t, 2, ACTION_NONE, "", 0);
        }
        if (i == 4) {
            bytes memory t = RuleSetCodec.or_(_k2(RuleSetCodec.predicate(A1, 120_000, hex"0102030405"), RuleSetCodec.codehash(A2, H32, false)));
            return _one(t, 1, ACTION_NONE, "", 0);
        }
        RuleSetCodec.Rule[] memory r = new RuleSetCodec.Rule[](3);
        r[0] = RuleSetCodec.withRetry(RuleSetCodec.rule(RuleSetCodec.cmp(RuleSetCodec.srcGetter(A1, SEL, 30_000), OP_GT, 100), 1, ACTION_CALL, RuleSetCodec.actionCall(A2, 0, hex"12345678"), 50_000));
        r[1] = RuleSetCodec.rule(RuleSetCodec.cmp(RuleSetCodec.srcGetter(A1, SEL, 30_000), OP_GT, 10), 1, ACTION_NONE, "", 0);
        r[2] = RuleSetCodec.withRetry(RuleSetCodec.rule(RuleSetCodec.constant_(true), 1, ACTION_CALL, RuleSetCodec.actionCall(A3, 0, ""), 60_000));
        return RuleSetCodec.encode(1, r);
    }

    function _ok(bytes memory c) internal view returns (bool) {
        try v.validate(c) {
            return true;
        } catch {
            return false;
        }
    }

    function test_solidity_builders_match_the_sdk_encoder_byte_for_byte() public view {
        string memory json = vm.readFile("test/fixtures/ruleset-vectors.json");
        for (uint256 i; i < 6; ++i) {
            bytes memory fromSdk = vm.parseJsonBytes(json, string.concat(".valid[", _s(i), "].config"));
            bytes memory fromSol = _vector(i);
            require(keccak256(fromSdk) == keccak256(fromSol), string.concat("vector ", _s(i), ": SDK and Solidity encoders differ"));
            require(_ok(fromSdk), string.concat("vector ", _s(i), ": the Solidity validator refuses an SDK config"));
        }
    }

    function test_both_validators_refuse_every_invalid_vector() public view {
        string memory json = vm.readFile("test/fixtures/ruleset-vectors.json");
        for (uint256 i; i < 16; ++i) {
            bytes memory c = vm.parseJsonBytes(json, string.concat(".invalid[", _s(i), "].config"));
            require(!_ok(c), string.concat("invalid vector ", _s(i), " was accepted by the Solidity validator"));
        }
    }

    function _s(uint256 x) internal pure returns (string memory) {
        if (x == 0) return "0";
        uint256 n;
        for (uint256 t = x; t != 0; t /= 10) ++n;
        bytes memory b = new bytes(n);
        for (uint256 t = x; t != 0; t /= 10) b[--n] = bytes1(uint8(48 + (t % 10)));
        return string(b);
    }
}

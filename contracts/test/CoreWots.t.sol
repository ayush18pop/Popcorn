pragma solidity ^0.8.28;

interface Vm {
    function readFile(string calldata) external view returns (string memory);
    function parseBytes(string calldata) external pure returns (bytes memory);
    function parseJsonUint(string calldata, string calldata) external pure returns (uint256);
    function parseJsonBytes32(string calldata, string calldata) external pure returns (bytes32);
    function parseJsonBytes(string calldata, string calldata) external pure returns (bytes memory);
}

/// Differential test of the owner path's WOTS+ math: Core's own wotsVerify/wotsChain, extracted verbatim from
/// core/PopcornCore.yul by core/build.sh into core/out/PopcornCore.wots-harness.bin, against the TypeScript signer's vectors
/// (test/fixtures/wots-vectors.json, generated by the SDK's WOTS+ signer). Every vector must verify;
/// every mutation (message bit, leaf, a byte in a chain value, in the first/last chain, in the checksum chains, in each path node) must not.
contract CoreWotsTest {
    Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    address h;
    string json;
    uint256 n;

    function setUp() public {
        bytes memory b = bytes(vm.readFile("core/out/PopcornCore.wots-harness.bin"));
        uint256 len = b.length;
        while (len > 0 && (b[len - 1] == 0x0a || b[len - 1] == 0x0d)) len--;
        bytes memory o = new bytes(len);
        for (uint256 i; i < len; i++) o[i] = b[i];
        bytes memory code = vm.parseBytes(string.concat("0x", string(o)));
        address a;
        assembly {
            a := create(0, add(code, 0x20), mload(code))
        }
        require(a != address(0), "harness deploy");
        h = a;
        json = vm.readFile("test/fixtures/wots-vectors.json");
        n = 42;
    }

    function _key(uint256 i, string memory f) internal pure returns (string memory) {
        return string.concat("$[", _u(i), "].", f);
    }

    function _u(uint256 x) internal pure returns (string memory) {
        if (x == 0) return "0";
        uint256 d;
        for (uint256 t = x; t > 0; t /= 10) d++;
        bytes memory s = new bytes(d);
        while (x > 0) {
            s[--d] = bytes1(uint8(48 + (x % 10)));
            x /= 10;
        }
        return string(s);
    }

    function _verify(bytes32 root, bytes32 seed, uint256 leaf, bytes32 msg_, bytes memory sig) internal returns (bool) {
        (bool ok, bytes memory ret) = h.call(abi.encodePacked(root, seed, leaf, msg_, sig));
        require(ok && ret.length == 32, "harness call");
        return abi.decode(ret, (uint256)) == 1;
    }

    function _sig(bytes memory entry) internal pure returns (bytes memory s) {
        s = new bytes(entry.length - 32);
        for (uint256 i; i < s.length; i++) s[i] = entry[i + 32];
    }

    function test_everyTsVectorVerifiesInCore() public {
        for (uint256 i; i < n; i++) {
            bytes memory entry = vm.parseJsonBytes(json, _key(i, "entry"));
            require(entry.length == 2496, "entry length");
            require(uint256(bytes32(entry)) == vm.parseJsonUint(json, _key(i, "leaf")), "leaf field");
            require(_verify(vm.parseJsonBytes32(json, _key(i, "root")), vm.parseJsonBytes32(json, _key(i, "pubSeed")), vm.parseJsonUint(json, _key(i, "leaf")), vm.parseJsonBytes32(json, _key(i, "msg")), _sig(entry)), "vector must verify");
        }
    }

    function test_mutationsAreRejected() public {
        uint256 tot;
        for (uint256 i; i < n; i += 3) {
            bytes32 root = vm.parseJsonBytes32(json, _key(i, "root"));
            bytes32 seed = vm.parseJsonBytes32(json, _key(i, "pubSeed"));
            uint256 leaf = vm.parseJsonUint(json, _key(i, "leaf"));
            bytes32 msg_ = vm.parseJsonBytes32(json, _key(i, "msg"));
            bytes memory sig = _sig(vm.parseJsonBytes(json, _key(i, "entry")));
            require(!_verify(root, seed, leaf, bytes32(uint256(msg_) ^ 1), sig), "msg bit");
            require(!_verify(root, seed, leaf ^ 1, msg_, sig), "leaf index");
            require(!_verify(root, bytes32(uint256(seed) ^ 1), leaf, msg_, sig), "pubSeed");
            require(!_verify(bytes32(uint256(root) ^ 1), seed, leaf, msg_, sig), "root");
            // chain 0, chain 63 (last message chain), chain 64 (first checksum chain), chain 66, path node 0 and 9
            uint256[6] memory at = [uint256(0), 63 * 32 + 5, 64 * 32, 66 * 32 + 31, 67 * 32 + 1, 76 * 32 + 10];
            for (uint256 k; k < 6; k++) {
                bytes memory m = sig;
                m[at[k]] = bytes1(uint8(m[at[k]]) ^ 1);
                require(!_verify(root, seed, leaf, msg_, m), "flipped byte");
                tot++;
            }
        }
        require(tot > 0, "ran");
    }
}
